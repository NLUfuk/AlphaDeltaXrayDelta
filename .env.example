# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# --- SQL Server ---
# Strong SA password (MSSQL requires 8+ chars incl. upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=Change_me_Strong123!

# --- JWT (secret) ---
# Generate a long random key, e.g.:  openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ISSUER=CrmKanban
JWT_AUDIENCE=CrmKanban

# --- MinIO / S3 ---
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=Change_me_minio_secret
S3_BUCKET=crm-kanban

# --- First super admin (seeded on startup) ---
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=Change_me_Admin123!

# --- Email (log = write to console; smtp = real send, needs Email__* SMTP settings) ---
EMAIL_PROVIDER=log

# --- Web ---
# Host port the SPA + API are served on (http://localhost:<WEB_PORT>).
WEB_PORT=8080
# Public origin for links in outbound email (activation/invite). Set to your real URL in production.
APP_PUBLIC_BASE_URL=http://localhost:8080

# --- Demo data ---
# true seeds two demo companies + sample CRM tickets/customers so the board and reports aren't empty.
# Leave false for a real production deployment.
SEED_DEMO=false

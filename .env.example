# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# --- SQL Server ---
# Strong SA password (MSSQL requires 8+ chars incl. upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=Change_me_Strong123!

# --- JWT (secret) ---
# Generate a long random key, e.g.:  openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ISSUER=CrmKanban
JWT_AUDIENCE=CrmKanban

# --- MinIO / S3 ---
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=Change_me_minio_secret
S3_BUCKET=crm-kanban
# Gercek AWS S3 icin: S3_SERVICE_URL'i BOS birak (satiri sil degil, bos degeriyle biraksin),
# S3_REGION=eu-central-1 gibi bolgeyi yaz, S3_FORCE_PATH_STYLE=false yap. MinIO icin bunlara dokunma.
#S3_SERVICE_URL=
#S3_REGION=eu-central-1
#S3_FORCE_PATH_STYLE=false

# --- First super admin (seeded on startup) ---
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=Change_me_Admin123!

# --- Email (log = write to console; smtp = real send) ---
# Brevo (transactional, free 300 mail/gun). Panel: SMTP & API > SMTP.
#   USERNAME = Brevo'nun verdigi SMTP login (ornek: 9a1b2c001@smtp-brevo.com) — hesap e-postan DEGIL.
#   PASSWORD = ayni ekrandaki SMTP key (xsmtpsib-... ile baslar), API key degil.
#   PORT 587 + USE_SSL=true (STARTTLS). 465 KULLANMA — .NET System.Net.Mail implicit SSL desteklemez.
#   FROM = Brevo'da dogrulanmis gonderici adresi (Senders & IP > Senders) ya da dogrulanmis domainde
#   bir adres; dogrulanmamis adresten gonderim reddedilir. FROM_NAME opsiyonel gorunen ad.
# Alternatifler: Resend (smtp.resend.com, USERNAME=resend, PASSWORD=re_...),
#   Gmail (smtp.gmail.com/587, USERNAME=adresin, PASSWORD=App Password, FROM=USERNAME).
EMAIL_PROVIDER=log
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=CRM Kanban
#   REPLY_TO = ZORUNLU, eger FROM bir freemail adresi ise (gmail/outlook/yahoo). Brevo boyle bir
#   FROM'u kendi <id>.brevosend.com alanina yeniden yazar ve Reply-To'ya ORIJINAL freemail adresi
#   koyar; SpamAssassin bunu FREEMAIL_FORGED_REPLYTO (+2.5) + FREEMAIL_REPLYTO_END_DIGIT (+0.25)
#   sayar. Kendi Reply-To'nu vermek bu enjeksiyonu engeller. Olculdu (mail-tester, canli relay):
#   bossa 4.9/10, doluyken 7.8/10. Freemail OLMAYAN bir adres ver (ornek: no-reply@<siten>).
EMAIL_REPLY_TO=

# --- Web ---
# Host port the SPA + API are served on (http://localhost:<WEB_PORT>).
WEB_PORT=8080
# Public origin for links in outbound email (activation/invite). Set to your real URL in production.
APP_PUBLIC_BASE_URL=http://localhost:8080

# --- Demo data ---
# true seeds two demo companies + sample CRM tickets/customers so the board and reports aren't empty.
# Leave false for a real production deployment.
SEED_DEMO=false
